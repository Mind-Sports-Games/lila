{
  "name": "chart",
  "private": true,
  "type": "module",
  "module": "index.js",
  "typings": "index",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  },
  "dependencies": {
    "chart.js": "^4.4.8",
    "chartjs-adapter-dayjs-4": "^1.0.4",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "common": "workspace:*",
    "dayjs": "^1.11.19",
