  },
  "playstrategy": {
    "bundles": [
      "src/chart.game.ts",
      "src/chart.lag.ts",
      "src/chart.ratingDistribution.ts",
      "src/chart.library.ts",
      "src/chart.ratingHistory.ts"
    ]
